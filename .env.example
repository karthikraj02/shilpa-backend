# ─────────────────────────────────────────────────────────────
# Backend environment variables
# Copy to backend/.env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────

# --- Database ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>
MONGO_DB_NAME=tourist_assistant

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Admin bootstrap (used only by `npm run create-admin`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- AI ---
GEMINI_API_KEY=

# --- Email (Gmail app password, not the account password) ---
EMAIL_USER=
EMAIL_PASS=

# --- CORS / links ---
# Production frontend origin. Requests from unknown origins are rejected.
FRONTEND_URL=https://your-production-domain.com
CLIENT_URL=
# Optional extra origins, comma separated
ADDITIONAL_ALLOWED_ORIGINS=
# Optional regex for your Vercel preview deployments
# VERCEL_PREVIEW_PATTERN=^https://m-sc-final-year-project[a-z0-9-]*\.vercel\.app$

# --- Behaviour switches ---
# true  = community submissions are published immediately (old behaviour)
# false = submissions wait for admin approval (default, recommended)
COMMUNITY_AUTO_APPROVE=false
# Set to false in production to stop the seeder / destination cleanup running on boot
AUTO_SEED=true
AUTO_CLEANUP_DESTINATIONS=true
# Only for local load testing
DISABLE_RATE_LIMIT=false

PORT=5005
